# Copy to .env and fill in. Never commit .env.
MODEL_API_KEY=
MODEL_API_BASE=https://api.meta.ai/v1
# Run scripts/ping.py to see which models your key has, then set this.
MODEL_NAME=muse-spark-1.3
# minimal | low | medium | high | xhigh. Empty = API default.
# Typed/voice: minimal scored 25/25 on the eval at half the cost of the default.
REASONING_EFFORT=minimal
# Photos of handwriting: API default until measured on real pages.
IMAGE_REASONING_EFFORT=
SHOP_TIMEZONE=Asia/Kolkata
# 1 = reuse saved real responses for identical inputs (saves credits while building UI)
KANAKKU_CACHE=1
# USD per 1M tokens, for cost logging. Check your dashboard.
PRICE_IN_PER_M=1.25
PRICE_OUT_PER_M=4.25
# Voice notes. Meta's ASR does not list Malayalam; Manglish works with keyword biasing (see README).
ASR_MODEL=muse-voice-transcribe-1.0
ASR_PRICE_PER_HOUR=0.18
# Shop name used in WhatsApp payment reminders
SHOP_NAME=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
